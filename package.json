{
  "name": "creche-auth-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "set WATCHPACK_POLLING=true && set NODE_OPTIONS=--no-warnings --max-old-space-size=4096 && next dev",
    "dev:polling": "set WATCHPACK_POLLING=true && set NODE_OPTIONS=--no-warnings --max-old-space-size=4096 && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up -d",
    "docker:prod": "docker-compose up -d",
    "docker:down": "docker-compose down && docker-compose -f docker-compose.dev.yml down"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@protobufjs/aspromise": "^1.1.2",
