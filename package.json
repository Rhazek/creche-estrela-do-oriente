    "@protobufjs/fetch": "^1.1.0",
    "@protobufjs/path": "^1.1.2",
    "autoprefixer": "^10.4.19",
    "clsx": "^2.1.1",
    "core-js": "^3.39.0",
    "firebase": "^10.14.1",
    "framer-motion": "^12.23.24",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.3",
    "lucide-react": "^0.546.0",
    "next": "14.2.5",
    "postcss": "^8.4.38",
    "react": "^18",
    "react-countup": "^6.5.3",
    "react-dom": "^18",
    "react-hook-form": "^7.65.0",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.3.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.1",
