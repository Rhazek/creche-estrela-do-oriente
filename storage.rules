rules_version = '2';

// Regras para Firebase Storage
service firebase.storage {
  match /b/{bucket}/o {
    // Regras para pré-matrículas
    match /pre_enrollments/{preEnrollmentId}/{fileName} {
      // Permitir leitura e escrita para usuários autenticados
      allow read, write: if request.auth != null;
    }
    
    // Regras para matrículas (enrollments)
    match /enrollments/{enrollmentId}/{fileName} {
      // Permitir leitura e escrita para usuários autenticados
      allow read, write: if request.auth != null;
    }
    
    // Regras gerais para outros arquivos
    match /{allPaths=**} {
      // Permitir leitura e escrita para usuários autenticados
      allow read, write: if request.auth != null;
    }
  }
}
