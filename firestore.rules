rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Função para verificar se o usuário é administrador
    function isAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil == 'administrador';
    }
    
    // Função para verificar se o usuário é secretaria
    function isSecretaria() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil == 'funcionario';
    }
    
    // Função para verificar se o usuário é funcionário (admin ou secretaria)
    function isEmployee() {
      return isAdmin() || isSecretaria();
    }
    
    // Função para verificar se o usuário é o criador do documento
    function isOwner(resource) {
      return request.auth != null && request.auth.uid == resource.data.criadoPor;
    }
    
    // Coleção de usuários - apenas administradores podem gerenciar
    match /usuarios/{userId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    // Coleção de usuários pendentes - usuários podem criar seus próprios documentos, admins podem gerenciar
    match /usuarios_pendentes/{document} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == document;
      allow update, delete: if isAdmin();
    }
    
    // Coleção de matrículas (enrollments) - funcionários podem ler/escrever
    // Inclui matrículas pendentes criadas automaticamente a partir de pré-matrículas aprovadas
    match /enrollments/{enrollmentId} {
      allow read: if request.auth != null && (isEmployee() || isOwner(resource));
      allow create: if request.auth != null && isEmployee();
      allow update: if request.auth != null && (isEmployee() || isOwner(resource));
      allow delete: if isAdmin();
      
      // Subcoleções de matrículas seguem as mesmas regras
      match /{subcollection}/{document} {
        allow read: if request.auth != null && (isEmployee() || isOwner(get(/databases/$(database)/documents/enrollments/$(enrollmentId))));
        allow write: if request.auth != null && (isEmployee() || isOwner(get(/databases/$(database)/documents/enrollments/$(enrollmentId))));
      }
    }
    
    // Coleção de rascunhos - usuários podem gerenciar seus próprios rascunhos
    match /enrollments_drafts/{draftId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Coleção de pré-matrículas - funcionários podem gerenciar
    match /pre_enrollments/{preEnrollmentId} {
      allow read: if request.auth != null && isEmployee();
      allow create: if request.auth != null && isEmployee();
      allow update: if request.auth != null && isEmployee();
      allow delete: if request.auth != null && isEmployee();
    }
    
    // Coleção de matrículas legada (para compatibilidade)
    match /matriculas/{document} {
      allow read, write: if request.auth != null && isEmployee();
    }
  }
}
